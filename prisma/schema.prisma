generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Page {
  id            Int     @id @default(autoincrement())
  mangaName     String
  chapterNumber Decimal
  pageNumber    Int
  pageUrl       String
  panels        Panel[]

  @@unique([mangaName, chapterNumber, pageNumber])
}

model Panel {
  id                Int   @id @default(autoincrement())
  pageId            Int
  panelIndex        Int
  panelUrl          String
  // Expected JSON shape:
  // {
  //   "readingOrder": number,
  //   "dialogue": [
  //     {
  //       "order": number,
  //       "character": string,
  //       "type": "narration"|"dialogue",
  //       "description": string,
  //       "text": string
  //     }
  //   ]
  // }
  dialogDescription Json?
  page              Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, panelIndex])
}
